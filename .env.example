# Copy this file to .env and fill in your own values.
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_EMAIL=your-registered-email@example.com
# Generate this value with: npm run hash-password
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# SMTP configuration (example format; use your provider's SMTP details)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="FedEx Admin <your-sender@example.com>"
APP_BASE_URL=http://localhost:3000
